GEMINI_API_KEY=
PANGU_AI_PROVIDER=gemini
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_CODING_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=3
PANGU_CLOUD_REASONING_ENABLED=true
PANGU_ALLOW_SCREENSHOT_UPLOAD=false
PANGU_ALLOW_DOCUMENT_UPLOAD=false
PANGU_REDACT_SENSITIVE_DATA=true
PANGU_WAKE_COOLDOWN_SECONDS=2.0
PANGU_WAKE_ARCHIVE_SHA256=
PANGU_FULL_DUPLEX_VOICE_ENABLED=true
PANGU_AWARENESS_ENABLED=true
PANGU_AWARENESS_INTERVAL_SECONDS=5.0
PANGU_SCREEN_OBSERVATION_ENABLED=false
PANGU_SCREEN_OBSERVATION_INTERVAL_SECONDS=1.25
PANGU_SCREEN_OBSERVATION_OCR_ENABLED=true
PANGU_SCREEN_OBSERVATION_SUPPRESS_PASSWORD_CONTEXTS=true
PANGU_MEDIA_ENABLED=true
PANGU_BROWSER_ENABLED=false
PANGU_BROWSER_HEADLESS=false
PANGU_COMPUTER_USE_ENABLED=false
PANGU_GESTURES_ENABLED=false
PANGU_GESTURE_CAMERA_INDEX=0
PANGU_GESTURE_MODEL_PATH=models/vision/hand_landmarker.task
PANGU_RUNTIME_ROOT=
